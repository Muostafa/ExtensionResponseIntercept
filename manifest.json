{
  "manifest_version": 3,
  "name": "API Interceptor - Mock API Responses & Intercept HTTP Requests",
  "version": "2.5.0",
  "description": "Mock API responses in one click. Capture a real request, turn it into a mock. No account, no cloud — nothing leaves your machine.",
  "permissions": ["debugger", "storage", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-interception": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Toggle interception on the current tab"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
